<?xml version="1.0"?>
<ruleset name="UX Portfolio Bundle">
    <description>Code checks for the UX Portfolio Bundle plugin.</description>

    <file>.</file>
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/assets/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg name="parallel" value="8"/>
    <arg value="sp"/>

    <!-- Supported versions -->
    <config name="testVersion" value="7.4-"/>
    <config name="minimum_wp_version" value="6.0"/>
    <config name="ignore_warnings_on_exit" value="1"/>

    <!-- PHP 7.4+ compatibility -->
    <rule ref="PHPCompatibilityWP"/>
    <rule ref="Generic.PHP.Syntax"/>

    <!-- WordPress coding standards: formatting, security and best practices.
         Errors fail the check. -->
    <rule ref="WordPress">
        <!-- Not adopted: conventions that would mean renaming files or
             rewriting every condition, with no change in behavior. -->
        <exclude name="WordPress.Files.FileName"/>
        <exclude name="WordPress.PHP.YodaConditions"/>
        <exclude name="Universal.Operators.DisallowShortTernary"/>
        <exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames"/>

        <!-- Not adopted yet: docblocks on every file, class and function. -->
        <exclude name="Squiz.Commenting"/>
        <exclude name="Generic.Commenting.DocComment"/>

        <!-- Intentional: the plugin raises memory_limit to 256M on small hosts. -->
        <exclude name="WordPress.PHP.IniSet.memory_limit_Disallowed"/>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="ux-portfolio-optimized"/>
            </property>
        </properties>
    </rule>

    <!-- Reported, not failing -->
    <rule ref="WordPress.Security.EscapeOutput">
        <!-- Most flagged lines print values escaped earlier in the same
             function, which the November 2026 audit confirmed by hand. -->
        <type>warning</type>
    </rule>
    <rule ref="WordPress.WP.I18n.MissingTranslatorsComment">
        <type>warning</type>
    </rule>
    <rule ref="WordPress.PHP.NoSilencedErrors">
        <type>warning</type>
    </rule>
    <rule ref="WordPress.PHP.StrictInArray">
        <type>warning</type>
    </rule>
    <rule ref="WordPress.WP.AlternativeFunctions">
        <type>warning</type>
    </rule>
    <rule ref="WordPress.WP.EnqueuedResourceParameters">
        <type>warning</type>
    </rule>
    <rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
        <type>warning</type>
    </rule>
</ruleset>
